---
import type { Dictionary } from '../i18n';
interface Props { t: Dictionary['footer']; }
const { t } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="border-t border-line px-gutter py-10">
  <div class="mx-auto max-w-[1440px] flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <p class="type-label text-muted">{t.tagline}</p>
    <p class="type-label text-muted">© {year} Empirika · {t.rights}</p>
  </div>
</footer>
