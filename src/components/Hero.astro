---
import type { Dictionary } from '../i18n';
interface Props { t: Dictionary['hero']; }
const { t } = Astro.props;
---
<section class="relative min-h-svh flex flex-col justify-center px-gutter pt-28 pb-24" data-animate="hero">
  <p class="type-label text-muted">{t.kicker}</p>
  <h1 class="type-display mt-6 -ml-[0.04em]">
    {t.titleLines.map((line) => <span class="block">{line}</span>)}
  </h1>
  <p class="mt-9 max-w-[45ch] text-lg leading-relaxed text-muted">{t.subtitle}</p>
  <a href="#contact" class="type-label mt-10 inline-block w-fit border border-paper px-8 py-4 hover:bg-paper hover:text-ink transition-colors">{t.cta}</a>
  <div class="absolute inset-x-0 bottom-0 px-gutter pb-7 flex items-center gap-5" aria-hidden="true">
    <span class="h-px flex-1 bg-line"></span>
    <span class="type-label text-muted">8°03′S · 34°52′W</span>
  </div>
</section>
