---
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);
---
<section id="hero" data-hero class="relative flex h-[100svh] items-end overflow-hidden bg-ink">
  <video
    data-hero-video
    data-src="/hero/journey.mp4"
    poster="/hero/poster.jpg"
    muted
    playsinline
    preload="none"
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover opacity-60 [&.has-clip]:opacity-100 transition-opacity duration-700"
  ></video>
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/30 to-transparent"></div>
  <div data-hero-copy class="relative z-10 w-full px-6 pb-20 md:px-12">
    <h1 class="font-display text-[clamp(2.5rem,7.5vw,7rem)] font-semibold leading-[0.98] tracking-tight">
      <span class="hero-line relative block text-paper">
        <span class="hero-line-outline">{c.hero.line1}</span>
        <span class="hero-line-fill" data-line-fill aria-hidden="true">{c.hero.line1}</span>
      </span>
      <span class="hero-line relative block text-mute">
        <span class="hero-line-outline">{c.hero.line2}</span>
        <span class="hero-line-fill" data-line-fill aria-hidden="true">{c.hero.line2}</span>
      </span>
    </h1>
    <p class="mt-12 font-mono text-xs uppercase tracking-widest text-mute" data-scroll-cue>{c.hero.scroll} ↓</p>
  </div>
</section>

<script>
  import { initHeroScrub } from '../scripts/hero-scrub';
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach(initHeroScrub);
</script>
