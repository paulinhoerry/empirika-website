---
import type { Dictionary } from '../i18n';
interface Props { t: Dictionary['recife']; }
const { t } = Astro.props;
---
<section id="recife" class="px-gutter py-section" data-animate="reveal">
  <div class="mx-auto max-w-[1440px]" data-animate-children>
    <div class="flex items-center gap-5 mb-10" aria-hidden="true">
      <span class="type-label text-muted">04</span>
      <span class="h-px flex-1 bg-line"></span>
      <span class="type-label text-muted">Porto Digital · 8°03′S</span>
    </div>
    <div class="lg:grid lg:grid-cols-12 lg:gap-x-8">
      <h2 class="type-headline lg:col-span-12 mb-10">{t.heading}</h2>
      <div class="lg:col-start-4 lg:col-span-7 max-w-[65ch]">
        {t.paragraphs.map((p) => <p class="mb-5 text-lg leading-relaxed">{p}</p>)}
      </div>
    </div>
  </div>
</section>
