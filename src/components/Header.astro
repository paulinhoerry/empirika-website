---
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);
---
<header class="fixed inset-x-0 top-0 z-50 flex items-center justify-between px-6 py-5 mix-blend-difference md:px-12">
  <a href={locale === 'pt' ? '/' : '/en/'} class="font-display text-sm font-bold uppercase tracking-[0.2em]">Empirika</a>
  <nav class="flex items-center gap-6 font-mono text-xs uppercase tracking-widest">
    <a href="#capabilities" class="hidden text-mute transition-colors hover:text-paper sm:block">{c.nav.capabilities}</a>
    <a href="#approach" class="hidden text-mute transition-colors hover:text-paper sm:block">{c.nav.approach}</a>
    <a href="#contact" class="text-mute transition-colors hover:text-paper">{c.nav.contact}</a>
    <a href={c.nav.switchHref} class="border border-line px-2 py-1 text-mute transition-colors hover:text-paper">{c.nav.switch}</a>
  </nav>
</header>
