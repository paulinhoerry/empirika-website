---
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);
---
<header class="fixed inset-x-4 top-4 z-50 md:inset-x-8 md:top-6">
  <div class="glass flex items-center justify-between rounded-full py-3 pl-6 pr-3 md:pl-8">
    <a href={locale === 'pt' ? '/' : '/en/'} class="font-display text-sm font-bold uppercase tracking-[0.2em] text-paper">Empirika</a>
    <nav class="flex items-center gap-6 font-mono text-xs uppercase tracking-widest">
      <a href="#capabilities" class="hidden text-paper/70 transition-colors hover:text-paper sm:block">{c.nav.capabilities}</a>
      <a href="#approach" class="hidden text-paper/70 transition-colors hover:text-paper sm:block">{c.nav.approach}</a>
      <a href="#contact" class="text-paper/70 transition-colors hover:text-paper">{c.nav.contact}</a>
      <a href={c.nav.switchHref} class="glass rounded-full px-4 py-2 text-paper/80 transition-colors hover:text-paper">{c.nav.switch}</a>
    </nav>
  </div>
</header>
