---
import type { Dictionary } from '../i18n';
interface Props { t: Dictionary['services']; }
const { t } = Astro.props;
---
<section id="services" class="px-gutter py-section" data-animate="reveal">
  <div class="mx-auto max-w-[1440px]" data-animate-children>
    <div class="flex items-center gap-5 mb-10" aria-hidden="true">
      <span class="type-label text-muted">02</span>
      <span class="h-px flex-1 bg-line"></span>
    </div>
    <h2 class="type-headline mb-14">{t.heading}</h2>
    <ul class="grid gap-x-12 gap-y-12 md:grid-cols-2">
      {t.items.map((item) => (
        <li class="border-t border-line pt-6">
          <h3 class="text-xl md:text-2xl font-bold leading-tight">{item.title}</h3>
          <p class="mt-3 max-w-[55ch] text-muted leading-relaxed">{item.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
