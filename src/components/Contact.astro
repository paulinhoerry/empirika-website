---
import type { Dictionary, Locale } from '../i18n';
interface Props { t: Dictionary['contact']; locale: Locale; }
const { t, locale } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---
<section id="contact" class="relative overflow-clip px-gutter py-section" data-animate="reveal">
  <span class="type-numeral absolute top-[-0.05em] right-[-0.08em] text-raised pointer-events-none" aria-hidden="true" data-numeral>05</span>
  <div class="relative mx-auto max-w-[1440px]">
    <div class="lg:grid lg:grid-cols-12 lg:gap-x-8" data-animate-children>
      <div class="lg:col-span-5">
        <h2 class="type-poster mb-6">{t.heading}</h2>
        <p class="text-lg leading-relaxed text-muted mb-12 max-w-[40ch]">{t.subtitle}</p>
        <div class="border-t border-line pt-6 mb-8">
          <p class="type-label text-muted mb-2">{t.emailLabel}</p>
          <a href={`mailto:${t.email}`} class="text-lg underline decoration-1 underline-offset-4 hover:text-muted transition-colors">{t.email}</a>
        </div>
        <div class="border-t border-line pt-6">
          <p class="type-label text-muted mb-2">{t.locationLabel}</p>
          <p class="text-lg text-muted leading-relaxed">{t.location}</p>
        </div>
      </div>
      <form
        id="contact-form"
        method="POST"
        action="https://api.web3forms.com/submit"
        class="mt-14 lg:mt-0 lg:col-start-7 lg:col-span-6 max-w-xl grid gap-7"
        novalidate
        data-msg-sending={t.form.sending}
        data-msg-success={t.form.success}
        data-msg-error={t.form.error}
        data-msg-required={t.form.requiredError}
        data-msg-email={t.form.emailError}
        data-contact-email={t.email}
      >
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <div>
          <label for="cf-name" class="type-label text-muted block mb-2">{t.form.name}</label>
          <input id="cf-name" name="name" type="text" required aria-describedby="cf-name-error" class="w-full bg-raised border border-muted px-4 py-3 text-paper focus:border-paper outline-none transition-colors" />
          <p id="cf-name-error" class="field-error text-sm text-paper mt-2 hidden"></p>
        </div>
        <div>
          <label for="cf-email" class="type-label text-muted block mb-2">{t.form.email}</label>
          <input id="cf-email" name="email" type="email" required aria-describedby="cf-email-error" class="w-full bg-raised border border-muted px-4 py-3 text-paper focus:border-paper outline-none transition-colors" />
          <p id="cf-email-error" class="field-error text-sm text-paper mt-2 hidden"></p>
        </div>
        <div>
          <label for="cf-company" class="type-label text-muted block mb-2">{t.form.company}</label>
          <input id="cf-company" name="company" type="text" class="w-full bg-raised border border-muted px-4 py-3 text-paper focus:border-paper outline-none transition-colors" />
        </div>
        <div>
          <label for="cf-message" class="type-label text-muted block mb-2">{t.form.message}</label>
          <textarea id="cf-message" name="message" rows="5" required aria-describedby="cf-message-error" class="w-full bg-raised border border-muted px-4 py-3 text-paper focus:border-paper outline-none transition-colors"></textarea>
          <p id="cf-message-error" class="field-error text-sm text-paper mt-2 hidden"></p>
        </div>
        <button type="submit" class="type-label w-fit border border-paper px-8 py-4 hover:bg-paper hover:text-ink transition-colors disabled:opacity-60 disabled:pointer-events-none">{t.form.submit}</button>
        <p id="form-status" role="status" aria-live="polite" class="text-sm"></p>
      </form>
    </div>
  </div>
</section>

<script>
  import '../scripts/contact-form.ts';
</script>
